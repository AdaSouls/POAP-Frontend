# Pinata JWT, scoped to upload-only permissions (pinFileToIPFS/pinJSONToIPFS) — never grant
# admin/delete scope to a key used by this server. This is the real secret: it lives here,
# server-side, and must never be copied into the frontend's .env (that one only gets the URL
# below via REACT_APP_IPFS_API_URL).
PINATA_JWT=

PORT=4000
CORS_ALLOWED_ORIGIN=http://localhost:3000
