# API Configuration (Souls/Collections feature)
REACT_APP_API_BASE_URL="http://localhost:3333"

# Blockfrost (Cardano)
REACT_APP_BLOCKFROST_NETWORK="Preprod"
REACT_APP_BLOCKFROST_URL="https://cardano-preprod.blockfrost.io/api/v0"
REACT_APP_BLOCKFROST_PROJECT_ID="your_blockfrost_project_id"

# Midnight Network — POAP contract + indexer app-layer API (see poap-midnight repo)
REACT_APP_MIDNIGHT_CONTRACT_ADDRESS="your_deployed_poap_contract_address"
REACT_APP_MIDNIGHT_INDEXER_API_URL="http://localhost:3001"
# 'undeployed' (local devnet, default if unset) or 'preprod' — must match both the wallet
# extension's configured network and the network REACT_APP_MIDNIGHT_CONTRACT_ADDRESS was deployed to.
REACT_APP_MIDNIGHT_NETWORK_ID="undeployed"
# Always local, for every network — see providers.ts's buildProviders(). Run
# `docker compose -f devnet.yml up -d proof-server` from ../POAP-Midnight (works for local devnet
# AND for preprod/preview — the proof server itself is network-agnostic, only the node/indexer
# URLs above change per network).
REACT_APP_MIDNIGHT_PROOF_SERVER_URL="http://localhost:6300"

# IPFS metadata upload (local proxy — see server/). The Pinata secret lives in server/.env only,
# never here — this is just the URL of the local proxy.
REACT_APP_IPFS_API_URL="http://localhost:4000"

# Comma-separated list of shielded wallet addresses (mn_shield-addr_...) allowed to access the
# admin contract-deploy page at /admin/deploy. Compared against whichever wallet the admin connects
# there — see src/midnight/admin-deploy.service.ts. Client-side UI gating only (matches the existing
# isAdmin pattern in user-roles.provider.jsx) — the real trust boundary is still the connected
# wallet's own signature on the deploy transaction, not this list.
REACT_APP_ADMIN_WALLET_ADDRESSES=""
